{
  "name": "zzz-mod-hub",
  "private": true,
  "version": "1.2.7",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite --force",
    "clean": "node -e \"const fs=require('fs'); ['dist','node_modules/.vite'].forEach(d=>fs.rmSync(d,{recursive:true,force:true})); console.log('Cleaned dist and vite cache.');\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cargo": "cargo test --manifest-path src-tauri/Cargo.toml --lib -- --quiet",
    "check": "tsc --noEmit && vitest run --reporter=dot && node scripts/check-i18n.cjs && node scripts/check-modals.cjs",
    "preflight": "npm run check && npm run check:docs && npm run test:cargo && python scripts/sync_public.py --dry-run",
    "tauri": "tauri",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "check:i18n": "node scripts/check-i18n.cjs",
    "check:modals": "node scripts/check-modals.cjs",
    "check:docs": "node scripts/check-docs.cjs",
    "release": "python scripts/release.py",
    "sync:public": "python scripts/sync_public.py --push",
    "sync:public:dry": "python scripts/sync_public.py --dry-run",
    "cli": "cargo run --manifest-path src-tauri/Cargo.toml --bin zmm-cli --",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "husky"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.42.2",
    "i18next": "^26.3.6",
    "lucide-react": "^1.25.0",
    "react": "^19.1.0",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.10",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.0.4",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.0"
  }
}
